{
  "name": "Klavar",
  "short_name": "Klavar",
  "description": "Turn sheet music into Klavarskribo, piano roll, falling notes, numbered notation and more, and play it back.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14171D",
  "theme_color": "#14171D",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "score",
          "accept": [
            ".mscz",
            ".mscx",
            ".mxl",
            ".musicxml",
            ".xml",
            "application/x-musescore",
            "application/vnd.recordare.musicxml",
            "application/vnd.recordare.musicxml+xml",
            "application/xml",
            "text/xml",
            "application/zip",
            "application/octet-stream",
            "*/*"
          ]
        }
      ],
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
